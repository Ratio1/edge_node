{
 "name": "pinned_client",
 "about": "The bia1 case of 2026-11-10 on mainnet: a licensed node whose dAuth requests always reach the same oracle, and that oracle is saturated. On mainnet Cloudflare kept the node on r1s-01, whose node loop ran at 0.8 per second; its requests waited 2-7 minutes in the dAuth queue and were dropped, while the node gives up after 120 s. Here the start-up probe is pinned to r1s-04, refusals arrive at the mainnet rate (revoked and unlicensed nodes, about 2.4 per second per serving oracle), a Deeploy operation is left open and r1s-04 is limited to 0.35 CPU. The measurement is whether the pinned node still gets its settings.",
 "steps": [
  {
   "do": "load",
   "generator": "fleet",
   "args": [
    "--unlicensed",
    "40",
    "--refused-rate",
    "9.6"
   ]
  },
  {
   "do": "load",
   "generator": "cstore",
   "args": [
    "--period",
    "10",
    "--hsync",
    "120"
   ]
  },
  {
   "do": "run",
   "generator": "deeploy",
   "args": [
    "setup",
    "--jobs",
    "20"
   ]
  },
  {
   "do": "pin",
   "generator": "dauth",
   "node": "r1s-04"
  },
  {
   "do": "load",
   "generator": "dauth",
   "args": [
    "--secrets-rate",
    "0",
    "--probe-period",
    "10"
   ]
  },
  {
   "do": "wait",
   "seconds": 60
  },
  {
   "do": "phase",
   "name": "1_pinned_oracle_healthy"
  },
  {
   "do": "wait",
   "seconds": 180
  },
  {
   "do": "phase",
   "name": "2_job_running"
  },
  {
   "do": "run",
   "generator": "deeploy",
   "args": [
    "create",
    "--job",
    "1001",
    "--nodes",
    "r1w-02"
   ],
   "timeout": 900
  },
  {
   "do": "wait",
   "seconds": 60
  },
  {
   "do": "phase",
   "name": "3_pinned_oracle_saturated"
  },
  {
   "do": "node",
   "node": "r1w-02",
   "action": "kill"
  },
  {
   "do": "run",
   "generator": "deeploy",
   "args": [
    "delete",
    "--job",
    "1001",
    "--no-wait"
   ],
   "timeout": 300
  },
  {
   "do": "node",
   "node": "r1s-04",
   "cpus": 0.35
  },
  {
   "do": "wait",
   "seconds": 540
  },
  {
   "do": "profile",
   "seconds": 30,
   "name": "saturated",
   "nodes": [
    "r1s-04"
   ]
  },
  {
   "do": "wait",
   "seconds": 30
  },
  {
   "do": "node",
   "node": "r1s-04",
   "cpus": 12
  },
  {
   "do": "pin",
   "generator": "dauth",
   "node": null
  },
  {
   "do": "unload",
   "generator": "all"
  }
 ]
}