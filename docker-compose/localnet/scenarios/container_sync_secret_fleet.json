{
 "name": "container_sync_secret_fleet",
 "about": "Two container-sync sets on six workers that run Docker, every node on the tree \"next\" (code that supports a set secret), then a rollback of three workers to \"old\" and their re-upgrade. Set S0 (key lnet-sync-s0, no secret): provider on r1w-01, consumers on r1w-02 and r1w-03. Set S1 (key lnet-sync-k1, secret of set s1): provider on r1w-01 and consumers on r1w-02 and r1w-03 with the secret; on r1w-04 without a secret, on r1w-05 with the secret of another set (s9) and on r1w-06 with a malformed secret. Both providers publish every 90 s (40 at most). Checks while all run \"next\": S1 applies on r1w-02 and r1w-03 within 150 s with the set's format and a 64-hex mac, while r1w-04 refuses with the format line and r1w-05 with the mac line, before any download; S0 applies within 150 s; custody of every S1 job with a secret (stored placeholder, 0 bytes of the variable in the app); a secret scan for s1 and s9. Then r1w-02 is killed and started again and must apply the next publish. Then r1w-02, r1w-01 and r1w-03 move to \"old\" one at a time, and back to \"next\" (r1w-01 first). S0 must keep syncing through all of it (280 s rule). The S1 behaviour across the rollback (expected refusals included) is read after the run from the nodes' sync history and file logs, so no S1 check runs after the restart's. Last, r1w-06 (never moved, its malformed secret refused) must have run its app with SYNC off the whole time: the refusal line once per app start, no sync work line, no SYNC variables in the app, nothing received, quarantined or downloaded, its saved pipeline still enabled (sync_off). Needs init --arm next --workers 6 --docker-nodes r1w-01,...,r1w-06, the tree \"old\" staged, and the image redis:7-alpine on this machine.",
 "steps": [
  {"do": "image", "image": "redis:7-alpine", "tag": "localnet/syncapp:1"},
  {"do": "isolation", "image": "localnet/syncapp:1"},
  {"do": "run", "generator": "deeploy", "args": ["setup", "--first-job", "3001", "--jobs", "9", "--job-type", "53"], "timeout": 120},
  {"do": "phase", "name": "create"},
  {"do": "run", "generator": "deeploy", "args": ["sync-app", "--job", "3002", "--node", "r1w-02", "--role", "consumer", "--key", "lnet-sync-s0"], "timeout": 960},
  {"do": "run", "generator": "deeploy", "args": ["sync-app", "--job", "3003", "--node", "r1w-03", "--role", "consumer", "--key", "lnet-sync-s0"], "timeout": 960},
  {"do": "run", "generator": "deeploy", "args": ["sync-app", "--job", "3005", "--node", "r1w-02", "--role", "consumer", "--key", "lnet-sync-k1", "--secret", "s1"], "timeout": 960},
  {"do": "run", "generator": "deeploy", "args": ["sync-app", "--job", "3006", "--node", "r1w-03", "--role", "consumer", "--key", "lnet-sync-k1", "--secret", "s1"], "timeout": 960},
  {"do": "run", "generator": "deeploy", "args": ["sync-app", "--job", "3007", "--node", "r1w-04", "--role", "consumer", "--key", "lnet-sync-k1"], "timeout": 960},
  {"do": "run", "generator": "deeploy", "args": ["sync-app", "--job", "3008", "--node", "r1w-05", "--role", "consumer", "--key", "lnet-sync-k1", "--secret", "s9"], "timeout": 960},
  {"do": "run", "generator": "deeploy", "args": ["sync-app", "--job", "3009", "--node", "r1w-06", "--role", "consumer", "--key", "lnet-sync-k1", "--secret", "malformed"], "timeout": 960},
  {"do": "run", "generator": "deeploy", "args": ["sync-app", "--job", "3001", "--node", "r1w-01", "--role", "provider", "--key", "lnet-sync-s0", "--period", "90", "--publishes", "40"], "timeout": 960},
  {"do": "run", "generator": "deeploy", "args": ["sync-app", "--job", "3004", "--node", "r1w-01", "--role", "provider", "--key", "lnet-sync-k1", "--secret", "s1", "--period", "90", "--publishes", "40"], "timeout": 960},
  {"do": "phase", "name": "all_next"},
  {"do": "sync", "name": "k1", "key": "lnet-sync-k1", "provider": "r1w-01", "consumers": ["r1w-02", "r1w-03"], "publishes": 10, "within": 150, "timeout": 2400, "encryption": "r1fs-set-v1",
   "refusing": {"r1w-04": "unsupported encryption: 'r1fs-set-v1' (expected: 'r1fs-default')", "r1w-05": "record mac does not match this node's sync secret"}},
  {"do": "sync", "name": "s0", "key": "lnet-sync-s0", "provider": "r1w-01", "consumers": ["r1w-02", "r1w-03"], "publishes": 10, "within": 150, "timeout": 900, "encryption": "r1fs-default"},
  {"do": "custody", "job": 3004, "secret": "s1", "oracle": "r1s-01", "node": "r1w-01", "key": "lnet-sync-k1", "secret_len": 0},
  {"do": "custody", "job": 3005, "secret": "s1", "oracle": "r1s-01", "node": "r1w-02", "key": "lnet-sync-k1", "secret_len": 0},
  {"do": "custody", "job": 3006, "secret": "s1", "oracle": "r1s-01", "node": "r1w-03", "key": "lnet-sync-k1", "secret_len": 0},
  {"do": "custody", "job": 3008, "secret": "s9", "oracle": "r1s-01", "node": "r1w-05", "key": "lnet-sync-k1", "secret_len": 0},
  {"do": "custody", "job": 3009, "secret": "malformed", "oracle": "r1s-01"},
  {"do": "scan", "name": "s1_all_next", "secret": "s1"},
  {"do": "scan", "name": "s9_all_next", "secret": "s9"},
  {"do": "phase", "name": "restart_b"},
  {"do": "node", "node": "r1w-02", "action": "kill"},
  {"do": "wait", "seconds": 5},
  {"do": "node", "node": "r1w-02", "action": "start"},
  {"do": "wait", "seconds": 330},
  {"do": "sync", "name": "k1_restart", "key": "lnet-sync-k1", "provider": "r1w-01", "consumers": ["r1w-02", "r1w-03"], "publishes": 11, "within": 280, "timeout": 900, "encryption": "r1fs-set-v1",
   "refusing": {"r1w-04": "unsupported encryption: 'r1fs-set-v1' (expected: 'r1fs-default')", "r1w-05": "record mac does not match this node's sync secret"}},
  {"do": "phase", "name": "rollback"},
  {"do": "switch", "node": "r1w-02", "arm": "old"},
  {"do": "wait", "seconds": 240},
  {"do": "switch", "node": "r1w-01", "arm": "old"},
  {"do": "wait", "seconds": 270},
  {"do": "switch", "node": "r1w-03", "arm": "old"},
  {"do": "wait", "seconds": 270},
  {"do": "phase", "name": "reupgrade"},
  {"do": "switch", "node": "r1w-01", "arm": "next"},
  {"do": "switch", "node": "r1w-02", "arm": "next"},
  {"do": "switch", "node": "r1w-03", "arm": "next"},
  {"do": "wait", "seconds": 330},
  {"do": "sync", "name": "s0_final", "key": "lnet-sync-s0", "provider": "r1w-01", "consumers": ["r1w-02", "r1w-03"], "publishes": 10, "within": 280, "timeout": 900, "encryption": "r1fs-default"},
  {"do": "scan", "name": "s1_final", "secret": "s1"},
  {"do": "scan", "name": "s9_final", "secret": "s9"},
  {"do": "sync_off", "name": "f", "node": "r1w-06", "job": 3009, "key": "lnet-sync-k1"}
 ]
}
