{
 "name": "container_sync_secret_lowend",
 "about": "The all-\"next\" part of container_sync_secret_fleet (two sets on six workers, consumers that must refuse, custody, scans, a kill and start of r1w-02) on a weak consumer host: r1w-02 is limited to 0.35 CPU from the start (the limit stays through the kill and start) and each of its two consumer apps is given 1,000 received-history entries before the first publish. Same pass values as the fleet scenario's checks up to and including the restart check, and the same sync_off check of r1w-06 at the end; custody is checked for r1w-02's app only. Needs init --arm next --workers 6 --docker-nodes r1w-01,...,r1w-06 and the image redis:7-alpine on this machine.",
 "steps": [
  {"do": "node", "node": "r1w-02", "cpus": 0.35},
  {"do": "image", "image": "redis:7-alpine", "tag": "localnet/syncapp:1"},
  {"do": "isolation", "image": "localnet/syncapp:1"},
  {"do": "run", "generator": "deeploy", "args": ["setup", "--first-job", "3001", "--jobs", "9", "--job-type", "53"], "timeout": 120},
  {"do": "phase", "name": "create"},
  {"do": "run", "generator": "deeploy", "args": ["sync-app", "--job", "3002", "--node", "r1w-02", "--role", "consumer", "--key", "lnet-sync-s0"], "timeout": 960},
  {"do": "seed_history", "node": "r1w-02", "job": 3002, "count": 1000},
  {"do": "run", "generator": "deeploy", "args": ["sync-app", "--job", "3003", "--node", "r1w-03", "--role", "consumer", "--key", "lnet-sync-s0"], "timeout": 960},
  {"do": "run", "generator": "deeploy", "args": ["sync-app", "--job", "3005", "--node", "r1w-02", "--role", "consumer", "--key", "lnet-sync-k1", "--secret", "s1"], "timeout": 960},
  {"do": "seed_history", "node": "r1w-02", "job": 3005, "count": 1000},
  {"do": "run", "generator": "deeploy", "args": ["sync-app", "--job", "3006", "--node", "r1w-03", "--role", "consumer", "--key", "lnet-sync-k1", "--secret", "s1"], "timeout": 960},
  {"do": "run", "generator": "deeploy", "args": ["sync-app", "--job", "3007", "--node", "r1w-04", "--role", "consumer", "--key", "lnet-sync-k1"], "timeout": 960},
  {"do": "run", "generator": "deeploy", "args": ["sync-app", "--job", "3008", "--node", "r1w-05", "--role", "consumer", "--key", "lnet-sync-k1", "--secret", "s9"], "timeout": 960},
  {"do": "run", "generator": "deeploy", "args": ["sync-app", "--job", "3009", "--node", "r1w-06", "--role", "consumer", "--key", "lnet-sync-k1", "--secret", "malformed"], "timeout": 960},
  {"do": "run", "generator": "deeploy", "args": ["sync-app", "--job", "3001", "--node", "r1w-01", "--role", "provider", "--key", "lnet-sync-s0", "--period", "90", "--publishes", "40"], "timeout": 960},
  {"do": "run", "generator": "deeploy", "args": ["sync-app", "--job", "3004", "--node", "r1w-01", "--role", "provider", "--key", "lnet-sync-k1", "--secret", "s1", "--period", "90", "--publishes", "40"], "timeout": 960},
  {"do": "phase", "name": "all_next"},
  {"do": "sync", "name": "k1", "key": "lnet-sync-k1", "provider": "r1w-01", "consumers": ["r1w-02", "r1w-03"], "publishes": 10, "within": 150, "timeout": 2400, "encryption": "r1fs-set-v1", "refusing": {"r1w-04": "unsupported encryption: 'r1fs-set-v1' (expected: 'r1fs-default')", "r1w-05": "record mac does not match this node's sync secret"}},
  {"do": "sync", "name": "s0", "key": "lnet-sync-s0", "provider": "r1w-01", "consumers": ["r1w-02", "r1w-03"], "publishes": 10, "within": 150, "timeout": 900, "encryption": "r1fs-default"},
  {"do": "custody", "job": 3005, "secret": "s1", "oracle": "r1s-01", "node": "r1w-02", "key": "lnet-sync-k1", "secret_len": 0},
  {"do": "scan", "name": "s1_all_next", "secret": "s1"},
  {"do": "scan", "name": "s9_all_next", "secret": "s9"},
  {"do": "phase", "name": "restart_b"},
  {"do": "node", "node": "r1w-02", "action": "kill"},
  {"do": "wait", "seconds": 5},
  {"do": "node", "node": "r1w-02", "action": "start"},
  {"do": "wait", "seconds": 330},
  {"do": "sync", "name": "k1_restart", "key": "lnet-sync-k1", "provider": "r1w-01", "consumers": ["r1w-02", "r1w-03"], "publishes": 11, "within": 280, "timeout": 900, "encryption": "r1fs-set-v1", "refusing": {"r1w-04": "unsupported encryption: 'r1fs-set-v1' (expected: 'r1fs-default')", "r1w-05": "record mac does not match this node's sync secret"}},
  {"do": "scan", "name": "s1_end", "secret": "s1"},
  {"do": "sync_off", "name": "f", "node": "r1w-06", "job": 3009, "key": "lnet-sync-k1"}
 ]
}
