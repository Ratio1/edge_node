{
 "name": "cstore_ramp",
 "about": "How many chain-store writes a second the network takes before something gives: five writers (each waits for its confirmation), the write period shortened phase by phase, then the 0.5 s period again with one oracle limited to 0.35 CPU. The measurements are the writes confirmed and their delay, the chain-store queue and loop rate, replica saves, CPU, and what dAuth start-up requests pay for it.",
 "steps": [
  {
   "do": "load",
   "generator": "fleet",
   "args": [
    "--unlicensed",
    "40",
    "--refused-rate",
    "9.6"
   ]
  },
  {
   "do": "load",
   "generator": "dauth",
   "args": [
    "--secrets-rate",
    "0",
    "--probe-period",
    "10"
   ]
  },
  {
   "do": "wait",
   "seconds": 60
  },
  {
   "do": "load",
   "generator": "cstore",
   "args": [
    "--period",
    "10",
    "--hsync",
    "120",
    "--keys",
    "50"
   ]
  },
  {
   "do": "wait",
   "seconds": 20
  },
  {
   "do": "phase",
   "name": "1_period_10s"
  },
  {
   "do": "wait",
   "seconds": 150
  },
  {
   "do": "unload",
   "generator": "cstore"
  },
  {
   "do": "load",
   "generator": "cstore",
   "args": [
    "--period",
    "2",
    "--hsync",
    "120",
    "--keys",
    "50"
   ]
  },
  {
   "do": "wait",
   "seconds": 20
  },
  {
   "do": "phase",
   "name": "2_period_2s"
  },
  {
   "do": "wait",
   "seconds": 150
  },
  {
   "do": "unload",
   "generator": "cstore"
  },
  {
   "do": "load",
   "generator": "cstore",
   "args": [
    "--period",
    "0.5",
    "--hsync",
    "120",
    "--keys",
    "50"
   ]
  },
  {
   "do": "wait",
   "seconds": 20
  },
  {
   "do": "phase",
   "name": "3_period_0.5s"
  },
  {
   "do": "wait",
   "seconds": 150
  },
  {
   "do": "unload",
   "generator": "cstore"
  },
  {
   "do": "load",
   "generator": "cstore",
   "args": [
    "--period",
    "0.2",
    "--hsync",
    "120",
    "--keys",
    "50"
   ]
  },
  {
   "do": "wait",
   "seconds": 20
  },
  {
   "do": "phase",
   "name": "4_period_0.2s"
  },
  {
   "do": "wait",
   "seconds": 150
  },
  {
   "do": "unload",
   "generator": "cstore"
  },
  {
   "do": "load",
   "generator": "cstore",
   "args": [
    "--period",
    "0.02",
    "--hsync",
    "120",
    "--keys",
    "50"
   ]
  },
  {
   "do": "wait",
   "seconds": 20
  },
  {
   "do": "phase",
   "name": "5_as_fast_as_confirmed"
  },
  {
   "do": "wait",
   "seconds": 150
  },
  {
   "do": "unload",
   "generator": "cstore"
  },
  {
   "do": "node",
   "node": "r1s-04",
   "cpus": 0.35
  },
  {
   "do": "load",
   "generator": "cstore",
   "args": [
    "--period",
    "0.5",
    "--hsync",
    "120",
    "--keys",
    "50"
   ]
  },
  {
   "do": "wait",
   "seconds": 20
  },
  {
   "do": "phase",
   "name": "6_period_0.5s_one_oracle_at_0.35_cpu"
  },
  {
   "do": "wait",
   "seconds": 150
  },
  {
   "do": "profile",
   "seconds": 30,
   "name": "ramp_starved",
   "nodes": [
    "r1s-04",
    "r1s-02"
   ]
  },
  {
   "do": "node",
   "node": "r1s-04",
   "cpus": 12
  },
  {
   "do": "unload",
   "generator": "all"
  }
 ]
}