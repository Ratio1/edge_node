{
 "name": "restart_catchup",
 "about": "Does an oracle that was away catch up in the signed namespaces? A job owner creates and deletes jobs through the Deeploy API without pause (every create and delete writes DEEPLOY_OPERATIONS, DEEPLOY_NODE_OPERATIONS, DEEPLOY_DEPLOYED_JOBS, DAUTH_JOB_SECRETS and DAUTH_JOB_SECRET_REVISIONS). The headless oracle r1s-db is killed (SIGKILL: a stop through the exception path would mark it offline for an hour), stays away 12 minutes under that load and is started again. Measured: per namespace, what each oracle's saved replica lacks or holds otherwise, before the kill, before the start and from 60 s to 810 s after the start (390 s and 810 s are the plan's readings); the chain store's statistics and census lines; the pauses of r1s-db's main loop and chain-store loop after its start. Needs init --probe-period 1 for the loop pauses.",
 "steps": [
  {"do": "run", "generator": "deeploy", "args": ["setup", "--first-job", "2001", "--jobs", "80", "--job-type", "16"]},
  {"do": "load", "generator": "deeploy", "args": ["cycle", "--first-job", "2001", "--jobs", "80", "--pause", "5"]},
  {"do": "phase", "name": "0_load"},
  {"do": "wait", "seconds": 300},
  {"do": "replicas", "name": "0_before_kill", "namespaces": ["DEEPLOY_OPERATIONS", "DEEPLOY_NODE_OPERATIONS", "DEEPLOY_DEPLOYED_JOBS", "DAUTH_JOB_SECRETS", "NODE_KEY_ROTATIONS", "DAUTH_JOB_SECRET_REVISIONS"]},
  {"do": "mark", "name": "kill"},
  {"do": "node", "node": "r1s-db", "action": "kill"},
  {"do": "phase", "name": "1_away"},
  {"do": "wait", "until": "kill", "seconds": 720},
  {"do": "replicas", "name": "1_before_start", "namespaces": ["DEEPLOY_OPERATIONS", "DEEPLOY_NODE_OPERATIONS", "DEEPLOY_DEPLOYED_JOBS", "DAUTH_JOB_SECRETS", "NODE_KEY_ROTATIONS", "DAUTH_JOB_SECRET_REVISIONS"]},
  {"do": "node", "node": "r1s-db", "action": "start"},
  {"do": "mark", "name": "start"},
  {"do": "phase", "name": "2_back"},
  {"do": "wait", "until": "start", "seconds": 60},
  {"do": "replicas", "name": "2_at_060s", "namespaces": ["DEEPLOY_OPERATIONS", "DEEPLOY_NODE_OPERATIONS", "DEEPLOY_DEPLOYED_JOBS", "DAUTH_JOB_SECRETS", "NODE_KEY_ROTATIONS", "DAUTH_JOB_SECRET_REVISIONS"]},
  {"do": "wait", "until": "start", "seconds": 120},
  {"do": "replicas", "name": "2_at_120s", "namespaces": ["DEEPLOY_OPERATIONS", "DEEPLOY_NODE_OPERATIONS", "DEEPLOY_DEPLOYED_JOBS", "DAUTH_JOB_SECRETS", "NODE_KEY_ROTATIONS", "DAUTH_JOB_SECRET_REVISIONS"]},
  {"do": "wait", "until": "start", "seconds": 180},
  {"do": "replicas", "name": "2_at_180s", "namespaces": ["DEEPLOY_OPERATIONS", "DEEPLOY_NODE_OPERATIONS", "DEEPLOY_DEPLOYED_JOBS", "DAUTH_JOB_SECRETS", "NODE_KEY_ROTATIONS", "DAUTH_JOB_SECRET_REVISIONS"]},
  {"do": "wait", "until": "start", "seconds": 240},
  {"do": "replicas", "name": "2_at_240s", "namespaces": ["DEEPLOY_OPERATIONS", "DEEPLOY_NODE_OPERATIONS", "DEEPLOY_DEPLOYED_JOBS", "DAUTH_JOB_SECRETS", "NODE_KEY_ROTATIONS", "DAUTH_JOB_SECRET_REVISIONS"]},
  {"do": "wait", "until": "start", "seconds": 300},
  {"do": "replicas", "name": "2_at_300s", "namespaces": ["DEEPLOY_OPERATIONS", "DEEPLOY_NODE_OPERATIONS", "DEEPLOY_DEPLOYED_JOBS", "DAUTH_JOB_SECRETS", "NODE_KEY_ROTATIONS", "DAUTH_JOB_SECRET_REVISIONS"]},
  {"do": "wait", "until": "start", "seconds": 390},
  {"do": "replicas", "name": "3_at_390s", "namespaces": ["DEEPLOY_OPERATIONS", "DEEPLOY_NODE_OPERATIONS", "DEEPLOY_DEPLOYED_JOBS", "DAUTH_JOB_SECRETS", "NODE_KEY_ROTATIONS", "DAUTH_JOB_SECRET_REVISIONS"]},
  {"do": "wait", "until": "start", "seconds": 510},
  {"do": "replicas", "name": "3_at_510s", "namespaces": ["DEEPLOY_OPERATIONS", "DEEPLOY_NODE_OPERATIONS", "DEEPLOY_DEPLOYED_JOBS", "DAUTH_JOB_SECRETS", "NODE_KEY_ROTATIONS", "DAUTH_JOB_SECRET_REVISIONS"]},
  {"do": "wait", "until": "start", "seconds": 630},
  {"do": "replicas", "name": "3_at_630s", "namespaces": ["DEEPLOY_OPERATIONS", "DEEPLOY_NODE_OPERATIONS", "DEEPLOY_DEPLOYED_JOBS", "DAUTH_JOB_SECRETS", "NODE_KEY_ROTATIONS", "DAUTH_JOB_SECRET_REVISIONS"]},
  {"do": "wait", "until": "start", "seconds": 810},
  {"do": "replicas", "name": "4_at_810s", "namespaces": ["DEEPLOY_OPERATIONS", "DEEPLOY_NODE_OPERATIONS", "DEEPLOY_DEPLOYED_JOBS", "DAUTH_JOB_SECRETS", "NODE_KEY_ROTATIONS", "DAUTH_JOB_SECRET_REVISIONS"]},
  {"do": "loops", "node": "r1s-db", "from": "start", "name": "r1s-db_back"},
  {"do": "unload", "generator": "all"},
  {"do": "cstats", "name": "run", "from": "scenario"}
 ]
}
