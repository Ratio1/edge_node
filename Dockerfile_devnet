# Base image: CPU by default, override with --build-arg BASE_IMAGE=ratio1/base_edge_node_amd64_gpu:latest for GPU
# The base image provides: Python 3.13, PyTorch, FFmpeg, Docker Engine (DIND), Node.js, uv, and ML/data stack
ARG BASE_IMAGE=ratio1/base_edge_node_amd64_cpu:latest
FROM ${BASE_IMAGE}

# Install IPFS (Kubo) — needed for R1FS decentralized file system
ARG KUBO_VERSION=v0.35.0
RUN set -eux; \
    curl -fsSLo kubo.tar.gz https://github.com/ipfs/kubo/releases/download/${KUBO_VERSION}/kubo_${KUBO_VERSION}_linux-amd64.tar.gz \
      || curl -fsSLo kubo.tar.gz https://dist.ipfs.tech/kubo/${KUBO_VERSION}/kubo_${KUBO_VERSION}_linux-amd64.tar.gz; \
    tar -xzf kubo.tar.gz; \
    cd kubo && bash install.sh; \
    cd / && rm -rf kubo kubo.tar.gz

# Install Cloudflared — tunnel engine for exposing webapp endpoints
ARG CLOUDFLARED_VERSION=2026.10.4
RUN set -eux; \
    arch="$(uname -m)"; \
    case "$arch" in \
      x86_64)  arch=amd64  ;; \
      aarch64 | arm64) arch=arm64 ;; \
      armv7l)  arch=armv7  ;; \
      *) echo "Unsupported arch: $arch" >&2; exit 1 ;; \
    esac; \
    curl -L "https://github.com/cloudflare/cloudflared/releases/download/${CLOUDFLARED_VERSION}/cloudflared-linux-${arch}" \
         -o /usr/local/bin/cloudflared; \
    chmod +x /usr/local/bin/cloudflared; \
    cloudflared --version

COPY ./cmds /usr/local/bin/
RUN chmod +x /usr/local/bin/*


WORKDIR /edge_node
COPY . .
RUN rm -rf /edge_node/cmds

# Offline build: a context-relative database overrides the CI download (CI never sets it).
ARG VULNDB_PATH=
RUN if [ -n "$VULNDB_PATH" ]; then \
      cp "/edge_node/$VULNDB_PATH" /edge_node/extensions/business/cybersec/red_mesh/vulndb/vulndb.sqlite && \
      python3 /edge_node/.github/actions/fetch-vulndb/verify_vulndb.py local-pin \
        /edge_node/extensions/business/cybersec/red_mesh/vulndb/vulndb.sqlite \
        /edge_node/extensions/business/cybersec/red_mesh/vulndb/pin.json; \
    fi

# set a generic env variable 
ENV AINODE_DOCKER=Yes
# set a generic env variable 
ENV AINODE_DOCKER_SOURCE=develop
# enable Docker-in-Docker in the optional base-image entrypoint
ENV EE_DD=1
# The base image must bring no settings file for its Docker daemon: the copy below would replace it without a word
# and what it set would be lost on every node. Fail the build instead. It must also have flock, which
# cmds/node_entrypoint locks the kept store with before it starts the daemon: without it every node start would stop
# with exit 1, so the build stops here, with a line that says so.
RUN test ! -e /etc/docker/daemon.json && { command -v flock || { echo "The base image has no flock, which cmds/node_entrypoint locks the kept Docker store with: not building." >&2; exit 1; }; }
# Keep the store of the inner Docker daemon (images, containers, volumes) in the directory this file names, under
# the mounted /edge_node/_local_cache, so app images survive a node restart. Before, the store was /var/lib/docker on
# this container's own layer, deleted at every stop: every app image was pulled again at every start (9-54 s per app).
# The directory is in the cache's `_bin` folder, which the disk API of plugin code refuses: the store holds every
# app's environment, layers and logs, and a delete of it would remove every app's image.
COPY ./docker/daemon.json /etc/docker/daemon.json
# Fail the build, not a node: dockerd must accept that file together with the flags the base image entrypoint
# passes, because an option set both as a flag and in the file stops dockerd, and so the node, at every start.
# --tlsverify is left out (its certificates exist only on a started node); `tls` or `tlsverify` in the file fail
# this step for the same reason.
RUN dockerd --validate --host=unix:///var/run/docker.sock --storage-driver=vfs --tlscacert=/certs/server/ca.pem --tlscert=/certs/server/cert.pem --tlskey=/certs/server/key.pem
# The entrypoint itself must not set the store directory (dockerd would refuse the two) and must not name another
# settings file (this one would not be read). The count of such lines must be exactly 0, so a base image without
# this entrypoint file fails here too.
RUN grep -cE -- '--(data-root|config-file)' /usr/local/bin/entrypoint.sh | grep -qx 0
# The store directory is named after the Docker major that writes it. A base image with another major needs a new
# directory name there and here, so that a node rolled back to an older image never reads a store written by
# another Docker major.
RUN dockerd --version | grep -q "^Docker version 29\."
# Start through cmds/node_entrypoint (copied to /usr/local/bin above), not through the base image entrypoint alone.
# The script runs that entrypoint unchanged to start dockerd, then the command of this image as process 1, as
# before. When dockerd does not start, for whatever reason, it removes the store directory daemon.json names and
# stops the container, so the next start begins on an empty store and pulls every app image once. Without it, a
# store dockerd refuses stops the node at every start, until someone removes the directory on the host.
ENTRYPOINT ["/usr/local/bin/node_entrypoint"]
# set default Execution Engine id
ENV EE_ID=E2dkr
# Temporary fix:
ENV AINODE_ENV=$AI_ENV
ENV AINODE_ENV_VER=$AI_ENV_VER
# configure default config_startup file
ENV EE_CONFIG=.config_startup.json

ENV EE_ETH_ENABLED=true

ENV EE_HB_CONTAINS_PIPELINES=0
ENV EE_HB_CONTAINS_ACTIVE_PLUGINS=1
ENV EE_EPOCH_MANAGER_DEBUG=1

ENV EE_NETMON_ADDRESS_INDEX=true
ENV EE_NETMON_SEND_CURRENT_NETWORK_EACH=50
ENV EE_NETMON_SEND_ONLY_ONLINE=true
# Default rollout policy: non-supervisors derive both heartbeat receive
# reduction and authorized NetMon summary fallback from this single switch.
ENV EE_NETMON_ORACLE_ONLY_HEARTBEAT_MODE=1

ENV EE_EVM_NET=devnet

ENV EE_DEBUG_R1FS=true

#### TO BE REMOVED AND TESTED !!!
# ENV TZ=Europe/Bucharest
# RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone
#### END TO BE REMOVED

# also can use EE_DEVICE to define target such as cuda:0 or cuda:1 instead of cpu
# althouh this is not recommended as it should be in .env file
# ENV EE_DEVICE=cuda:0

RUN uv pip install --system --no-cache -r requirements.txt
RUN uv pip install --system --no-cache --no-deps naeural-core
#RUN pip install --no-cache-dir -r requirements.txt
#RUN pip install --no-cache-dir --no-deps naeural-core

CMD ["python3","device.py"]
